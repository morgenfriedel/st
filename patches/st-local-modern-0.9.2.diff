+ */
+void
+newterm(const Arg *a)
+{
+	const char *argv[] = { "st", NULL };
+	char path[32], *cwd;
+	pid_t fg = tcgetpgrp(cmdfd);
+
+	snprintf(path, sizeof(path), "/proc/%d/cwd", fg > 0 ? fg : pid);
+	if (!(cwd = realpath(path, NULL))) {
+		snprintf(path, sizeof(path), "/proc/%d/cwd", pid);
+		cwd = realpath(path, NULL);
+	}
+	spawn(argv, cwd);
+	free(cwd);
+}
