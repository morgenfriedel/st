+/* whether drawing is held back by a synchronized update; it expires */
+int
+tinsync(uint timeout)
+{
+	struct timespec now;
+
+	if (su) {
+		clock_gettime(CLOCK_MONOTONIC, &now);
+		if (TIMEDIFF(now, sutv) >= timeout)
+			su = 0;
+	}
